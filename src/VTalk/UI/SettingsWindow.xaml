<Window x:Class="VTalk.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayarlar" Width="500" Height="640" ResizeMode="CanResizeWithGrip"
        Icon="pack://application:,,,/Assets/vtalk.ico"
        Background="{StaticResource WindowBrush}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Style="{StaticResource ToolButton}" Content="Vazgeç" Width="90" IsCancel="True"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Kaydet" Width="110" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Profil">
                    <StackPanel>
                        <TextBlock Text="Görünen ad"/>
                        <TextBox x:Name="NameBox" Padding="3" MaxLength="64" Margin="0,2,0,4"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}"
                                   Text="Admin dizininde kayıtlıysanız diğer kullanıcılar admin tarafından belirlenen adınızı görür."/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Bildirimler ve ses">
                    <StackPanel>
                        <CheckBox x:Name="SoundCheck" Content="Yeni mesajda ses çal" Margin="0,2"/>
                        <DockPanel Margin="20,2,0,2">
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="Dinle" Click="TestSound_Click"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="Seç…" Click="PickSound_Click"/>
                            <TextBox x:Name="SoundPathBox" Padding="3" IsReadOnly="True" ToolTip="Boş bırakılırsa yerleşik MSN tarzı ses kullanılır"/>
                        </DockPanel>
                        <Button Style="{StaticResource LinkButton}" Content="Yerleşik sese dön" Margin="20,0,0,4" HorizontalAlignment="Left" Click="ResetSound_Click"/>
                        <CheckBox x:Name="NotifyCheck" Content="Windows bildirimi göster (sağ alt köşe)" Margin="0,2"/>
                        <CheckBox x:Name="PreviewCheck" Content="Bildirimde mesaj içeriğini göster" Margin="20,2,0,2"
                                  ToolTip="Kapalıysa bildirimde yalnızca &quot;Yeni mesaj&quot; yazar (ekran paylaşımı, kilit ekranı için)."/>
                        <CheckBox x:Name="OnlineCheck" Content="Bir kişi çevrimiçi olduğunda bildir" Margin="0,2"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Dosyalar">
                    <StackPanel>
                        <TextBlock Text="Alınan dosyaların kaydedileceği klasör"/>
                        <DockPanel Margin="0,2,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="Gözat…" Click="PickFolder_Click"/>
                            <TextBox x:Name="FolderBox" Padding="3" IsReadOnly="True"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="AutoImageCheck" Content="Resimleri otomatik al (en fazla" VerticalAlignment="Center"/>
                            <TextBox x:Name="AutoImageMbBox" Width="44" Margin="4,0" Padding="2" MaxLength="3"/>
                            <TextBlock Text="MB)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Genel">
                    <StackPanel>
                        <CheckBox x:Name="StartupCheck" Content="Windows açıldığında V-Talk'u başlat" Margin="0,2"/>
                        <CheckBox x:Name="MinimizedCheck" Content="Simge durumunda (tepside) başlat" Margin="0,2"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Şu kadar dakika boşta kalınca &quot;Dışarıda&quot; göster:" VerticalAlignment="Center"/>
                            <TextBox x:Name="AwayBox" Width="44" Margin="6,0" Padding="2" MaxLength="3"/>
                        </StackPanel>
                        <TextBlock FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" Text="(0 = kapalı)"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Ağ (gelişmiş)">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="Farklı alt ağlara (VLAN) veya VPN üzerinden uzak şube/santrallere ulaşmak için ek IP ya da alt ağ (CIDR) girin (virgülle ayırın). Bu alt ağlar ayrıca güvenliye alınır."/>
                        <TextBox x:Name="ExtraBox" Padding="3" Margin="0,2,0,6" ToolTip="Örn: 10.20.30.0/24, 192.168.2.255, 10.0.5.20"/>
                        <CheckBox x:Name="PublicNetCheck" Margin="0,2,0,2"
                                  Content="Windows'ta &quot;Ortak (Public)&quot; olarak tanımlı ağlarda da çalış (önerilmez)"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" Margin="20,0,0,6"
                                   Text="Kapalıyken kafe, otel, havalimanı gibi ortak ağlarda kullanıcı adınız ve bilgisayar adınız yayınlanmaz, bu ağlardan bağlantı kabul edilmez."/>
                        <TextBlock x:Name="NetInfo" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Güvenlik">
                    <StackPanel>
                        <TextBlock x:Name="SecurityInfo" TextWrapping="Wrap" FontSize="12" FontFamily="Consolas"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"
                                   Text="Tüm mesajlar ve dosyalar uçtan uca şifreli (ECDH P-256 + AES-256-GCM) iletilir. Sohbet geçmişi yalnızca bu bilgisayarda, Windows hesabınıza bağlı anahtarla şifrelenmiş olarak saklanır."/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
