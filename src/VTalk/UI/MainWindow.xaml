<Window x:Class="VTalk.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="V-Talk" Width="360" Height="680" MinWidth="300" MinHeight="420"
        Icon="pack://application:,,,/Assets/vtalk.ico"
        Background="{StaticResource WindowBrush}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="Manual">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="White" Padding="2">
            <MenuItem Header="_Messenger">
                <MenuItem Header="Durum">
                    <MenuItem Header="Çevrimiçi" Tag="0" Click="StatusMenu_Click"/>
                    <MenuItem Header="Meşgul (sessiz)" Tag="1" Click="StatusMenu_Click"/>
                    <MenuItem Header="Dışarıda" Tag="2" Click="StatusMenu_Click"/>
                </MenuItem>
                <MenuItem Header="Profil resmini değiştir…" Click="ChangeAvatar_Click"/>
                <MenuItem Header="Alınan dosyalar klasörünü aç" Click="OpenDownloads_Click"/>
                <Separator/>
                <MenuItem Header="Ayarlar…" Click="Settings_Click"/>
                <Separator/>
                <MenuItem Header="Çıkış" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Yönetim">
                <MenuItem Header="Admin Girişi…" Click="AdminLogin_Click"/>
                <MenuItem x:Name="ShowPendingMenu" Header="Doğrulanmamış kişileri göster" IsCheckable="True"
                          Click="ShowPending_Click" Visibility="Collapsed"/>
                <MenuItem x:Name="VerifyAllMenu" Header="Bekleyenlerin tümünü doğrula…" Click="VerifyAll_Click" Visibility="Collapsed"/>
                <Separator/>
                <MenuItem x:Name="BulletinMenu" Header="Duyuru Gönder…" Click="Bulletin_Click"/>
            </MenuItem>
            <MenuItem Header="_Yardım">
                <MenuItem Header="Hakkında" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Profil başlığı -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <DockPanel>
                        <Ellipse x:Name="MyStatusDot" Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="StatusCombo" DockPanel.Dock="Right" Width="105" Margin="6,0,0,0"
                                  SelectionChanged="StatusCombo_SelectionChanged">
                            <ComboBoxItem Content="Çevrimiçi" Tag="0"/>
                            <ComboBoxItem Content="Meşgul" Tag="1"/>
                            <ComboBoxItem Content="Dışarıda" Tag="2"/>
                        </ComboBox>
                        <TextBlock x:Name="MyName" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock x:Name="MyRole" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="16,1,0,3"/>
                    <Grid>
                        <TextBox x:Name="NoteBox" Padding="3,2" MaxLength="128" KeyDown="NoteBox_KeyDown" LostFocus="NoteBox_LostFocus"
                                 BorderBrush="{StaticResource BorderBrush}"/>
                        <TextBlock Text="Bir not yazın…" Foreground="#A0A8B2" Margin="6,3,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=NoteBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
                <Button Grid.Column="1" Margin="10,0,0,0" Width="56" Height="56" Padding="0" Cursor="Hand" Click="ChangeAvatar_Click"
                        ToolTip="Profil resmini değiştir" BorderBrush="{StaticResource BorderBrush}" Background="White">
                    <Grid>
                        <Image Source="{StaticResource DefaultAvatar}" Stretch="UniformToFill"/>
                        <Image x:Name="MyAvatar" Stretch="UniformToFill"/>
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <!-- Arama -->
        <Border DockPanel.Dock="Top" Padding="8,6" Background="#EEF3F9">
            <Grid>
                <TextBox x:Name="SearchBox" Padding="4,3" TextChanged="SearchBox_TextChanged" BorderBrush="{StaticResource BorderBrush}"/>
                <TextBlock Text="🔍 Kişi ara…" Foreground="#A0A8B2" Margin="7,4,0,0" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Güvenlik uyarısı -->
        <Border x:Name="ConflictBar" DockPanel.Dock="Top" Background="#FDECEA" BorderBrush="#E0A09A" BorderThickness="0,1" Padding="8,5" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" Foreground="#9B2C20" FontSize="12"
                       Text="⚠ Ağda farklı bir organizasyon anahtarı yayınlayan bir cihaz tespit edildi. Rol bilgileri yalnızca güvenilen admin anahtarından kabul edilir."/>
        </Border>
        <Border x:Name="PublicNetBar" DockPanel.Dock="Top" Background="#FFF4E5" BorderBrush="#F0C27A" BorderThickness="0,1" Padding="8,5" Visibility="Collapsed">
            <TextBlock x:Name="PublicNetText" TextWrapping="Wrap" Foreground="#8A5A00" FontSize="12"/>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="CountText" Foreground="{StaticResource MutedTextBrush}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="OrgText" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>

        <ListBox x:Name="ContactList" BorderThickness="0" Background="White" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                 MouseDoubleClick="ContactList_MouseDoubleClick" KeyDown="ContactList_KeyDown"
                 ContextMenuOpening="ContactList_ContextMenuOpening"
                 AllowDrop="True" PreviewMouseLeftButtonDown="ContactList_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="ContactList_PreviewMouseMove" DragOver="ContactList_DragOver" Drop="ContactList_Drop">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GroupItem">
                                        <StackPanel>
                                            <ToggleButton x:Name="Toggle" IsChecked="True" Cursor="Hand" Focusable="False">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{StaticResource AccentBrush}" Padding="6,3">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path x:Name="Arrow" Data="M0,0 L9,0 L4.5,5 Z" Fill="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                <ContentPresenter/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="False">
                                                                <Setter TargetName="Arrow" Property="Data" Value="M0,0 L5,4.5 L0,9 Z"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                                <TextBlock Foreground="White" FontWeight="SemiBold">
                                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                                    <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=' ({0})'}" FontWeight="Normal"/>
                                                </TextBlock>
                                            </ToggleButton>
                                            <ItemsPresenter Visibility="{Binding IsChecked, ElementName=Toggle, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="6,4"/>
                    <Setter Property="ToolTip" Value="{Binding Tooltip}"/>
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="10" Height="10" Margin="2,0,8,0" VerticalAlignment="Center"
                                 Fill="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <Border Background="#FFF4D6" BorderBrush="#E8C766" BorderThickness="1" CornerRadius="3" Margin="6,0,0,0" Padding="4,0"
                                        Visibility="{Binding HasRoleBadge, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding RoleText}" FontSize="10" Foreground="#8A6500"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Note}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="#E03B2E" CornerRadius="9" MinWidth="18" Height="18" Margin="4,0" Padding="5,0"
                                VerticalAlignment="Center" Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Unread}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="3" Width="38" Height="38" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                            <Grid>
                                <Image Source="{StaticResource DefaultAvatar}" Stretch="UniformToFill"/>
                                <Image Source="{Binding Avatar}" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
