<Window x:Class="VTalk.UI.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:VTalk.UI"
        Title="Sohbet" Width="580" Height="560" MinWidth="380" MinHeight="360"
        Icon="pack://application:,,,/Assets/vtalk.ico"
        Background="{StaticResource WindowBrush}" FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="HeaderTemplate">
            <DockPanel Margin="0,8,0,1" Visibility="{Binding ShowHeader, Converter={StaticResource BoolToVis}}">
                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                <TextBlock FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource IncomingNameBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource OutgoingNameBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="{Binding SenderName, Mode=OneWay}"/><Run Text=" diyor ki:"/>
                </TextBlock>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="TextTemplate">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource HeaderTemplate}"/>
                <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         TextWrapping="Wrap" Padding="12,0,0,0" Margin="0" FontSize="13.5"/>
                <TextBlock Text="{Binding DeliveryText}" Foreground="#B26A00" FontSize="11" Margin="14,0,0,0"
                           Visibility="{Binding HasDeliveryText, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="NudgeTemplate">
            <Border Margin="0,8" Padding="8,4" Background="#FFF6E5" BorderBrush="#F2C98A" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Left">
                <TextBlock FontStyle="Italic" Foreground="#8A5A00">
                    <Run Text="📳 "/>
                    <Run Text="{Binding SenderName, Mode=OneWay}"/>
                    <Run Text=" bir titreşim gönderdi."/>
                    <Run Text="{Binding ShortTime, Mode=OneWay, StringFormat='({0})'}" Foreground="{StaticResource MutedTextBrush}"/>
                </TextBlock>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BulletinTemplate">
            <Border Margin="0,8" Padding="10,6" Background="#FFF9DB" BorderBrush="#E8C766" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                        <TextBlock FontWeight="Bold" Foreground="#8A6500">
                            <Run Text="{Binding BulletinTitle, Mode=OneWay}"/><Run Text=" — "/><Run Text="{Binding SenderName, Mode=OneWay}"/>
                        </TextBlock>
                    </DockPanel>
                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding DeliveryText}" Foreground="#B26A00" FontSize="11"
                               Visibility="{Binding HasDeliveryText, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FileTemplate">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource HeaderTemplate}"/>
                <Border Margin="12,2,0,2" Padding="8" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" HorizontalAlignment="Left" MinWidth="280" MaxWidth="460">
                    <StackPanel>
                        <Image Source="{Binding Image}" MaxHeight="320" MaxWidth="440" Stretch="Uniform" HorizontalAlignment="Left"
                               Cursor="Hand" Margin="0,0,0,6" MouseLeftButtonUp="Image_Click" ToolTip="Açmak için tıklayın"
                               Visibility="{Binding ShowImage, Converter={StaticResource BoolToVis}}"/>
                        <DockPanel>
                            <TextBlock Text="📎" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11.5">
                                    <Run Text="{Binding FileSizeText, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding FileStateText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                            <ProgressBar Height="6" Value="{Binding Progress, Mode=OneWay}" Maximum="100"/>
                            <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Kabul et" Style="{StaticResource LinkButton}" Click="Accept_Click"
                                    Visibility="{Binding CanAccept, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Reddet" Style="{StaticResource LinkButton}" Click="Reject_Click"
                                    Visibility="{Binding CanReject, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="İptal" Style="{StaticResource LinkButton}" Click="Cancel_Click"
                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Aç" Style="{StaticResource LinkButton}" Click="Open_Click"
                                    Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Klasörde göster" Style="{StaticResource LinkButton}" Click="ShowInFolder_Click"
                                    Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding DeliveryText}" Foreground="#B26A00" FontSize="11"
                                   Visibility="{Binding HasDeliveryText, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <ui:MessageTemplateSelector x:Key="MessageSelector"
                                    TextTemplate="{StaticResource TextTemplate}"
                                    FileTemplate="{StaticResource FileTemplate}"
                                    NudgeTemplate="{StaticResource NudgeTemplate}"
                                    BulletinTemplate="{StaticResource BulletinTemplate}"/>
    </Window.Resources>

    <DockPanel>
        <!-- Kişi başlığı -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel>
                <Border Width="52" Height="52" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" ClipToBounds="True" Margin="0,0,10,0">
                    <Grid>
                        <Image Source="{StaticResource DefaultAvatar}" Stretch="UniformToFill"/>
                        <Image x:Name="PeerAvatar" Stretch="UniformToFill"/>
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="PeerStatusDot" Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PeerName" FontWeight="Bold" FontSize="15"/>
                        <TextBlock x:Name="PeerStatus" Foreground="{StaticResource MutedTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="PeerNote" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PeerRole" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border x:Name="UnverifiedBar" DockPanel.Dock="Top" Background="#FFF4E5" BorderBrush="#F0C27A" BorderThickness="0,0,0,1" Padding="10,4" Visibility="Collapsed">
            <TextBlock x:Name="UnverifiedText" TextWrapping="Wrap" FontSize="12" Foreground="#8A5A00"
                       Text="⚠ Bu kişi admin dizininde doğrulanmamış. Görünen adı kendi beyanıdır; kimliğinden emin değilseniz parola veya hassas bilgi paylaşmayın, gönderdiği dosyaları açmayın."/>
        </Border>
        <Border x:Name="OfflineBar" DockPanel.Dock="Top" Background="#EEF1F5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,4" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                       Text="Kişi şu anda çevrimdışı. Mesajlarınız kuyruğa alınır ve kişi çevrimiçi olduğunda otomatik iletilir."/>
        </Border>

        <!-- Yazma alanı -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Style="{StaticResource ToolButton}" Click="SendFile_Click" ToolTip="Dosya gönder">📎 Dosya</Button>
                    <Button Style="{StaticResource ToolButton}" Click="SendImage_Click" ToolTip="Resim gönder (Ctrl+V ile yapıştırabilirsiniz)">🖼 Resim</Button>
                    <Button x:Name="NudgeButton" Style="{StaticResource ToolButton}" Click="Nudge_Click" ToolTip="Titreşim gönder">📳 Titret</Button>
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Gönder" Width="80" Margin="8,0,0,0" Click="Send_Click"/>
                <TextBox x:Name="InputBox" MinHeight="54" MaxHeight="140" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="InputBox_PreviewKeyDown" Padding="4" BorderBrush="{StaticResource BorderBrush}" MaxLength="16000"/>
            </DockPanel>
        </Border>

        <!-- Mesajlar -->
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Background="White" Padding="12,4,12,8">
            <StackPanel>
                <Button x:Name="LoadOlderButton" Content="Daha eski mesajları göster" Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Center" Margin="0,6" Click="LoadOlder_Click" Visibility="Collapsed"/>
                <ItemsControl x:Name="MessageList" ItemTemplateSelector="{StaticResource MessageSelector}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
