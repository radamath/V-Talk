<Window x:Class="VTalk.UI.SoundPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bildirim sesi" Width="400" Height="520" MinWidth="340" MinHeight="380"
        Icon="pack://application:,,,/Assets/vtalk.ico"
        Background="{StaticResource WindowBrush}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="Yeni mesaj sesi" FontWeight="SemiBold" FontSize="14"/>
        <TextBlock DockPanel.Dock="Top" Margin="0,2,0,8" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}"
                   Text="Bir sese tıklayınca çalar. Listede yoksa kendi .wav dosyanızı da seçebilirsiniz."/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Style="{StaticResource ToolButton}" Content="Vazgeç" Width="90" IsCancel="True"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Seç" Width="100" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Style="{StaticResource LinkButton}" Content="Kendi .wav dosyanızı seçin…" HorizontalAlignment="Left" Click="PickCustom_Click"/>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"
                       Text="Özel ses: sıkıştırılmamış PCM .wav, 8 veya 16 bit, en fazla 5 MB (MP3/OGG çalınmaz)."/>
        </StackPanel>

        <ListBox x:Name="SoundList" SelectionChanged="SoundList_SelectionChanged" BorderBrush="{StaticResource BorderBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="▶" Width="30" Height="26" Margin="6,0,0,0" Padding="0"
                                Style="{StaticResource ToolButton}" ToolTip="Dinle" Click="Play_Click" Focusable="False"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
