<Window x:Class="VTalk.UI.CreateGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grup sohbeti oluştur" Width="380" Height="460" MinWidth="320" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBrush}" FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Assets/vtalk.ico">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="Oluştur" Width="90" Margin="0,0,8,0" Click="Create_Click" IsDefault="True"/>
            <Button Style="{StaticResource ToolButton}" Content="İptal" Width="80" IsCancel="True"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="Grup adı" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox" Padding="4" MaxLength="64" Margin="0,0,0,10"/>
            <TextBlock Text="Üyeler (en az bir kişi seçin)" Margin="0,0,0,4"/>
            <TextBox x:Name="FilterBox" Padding="3" Margin="0,0,0,6" TextChanged="FilterBox_TextChanged"
                     ToolTip="Kişi ara"/>
            <ListBox x:Name="MemberList" Height="260" SelectionMode="Multiple" Background="White"
                     BorderBrush="{StaticResource BorderBrush}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </DockPanel>
</Window>
