<Window x:Class="VTalk.UI.InvitePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kişi seç" Width="360" Height="420" MinWidth="300" MinHeight="320"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBrush}" FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Assets/vtalk.ico">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="Davet et" Width="90" Margin="0,0,8,0" Click="Ok_Click" IsDefault="True"/>
            <Button Style="{StaticResource ToolButton}" Content="İptal" Width="80" IsCancel="True"/>
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="HintText" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource MutedTextBrush}"
                       Text="Sohbete geçici olarak dahil edilecek kişiyi seçin."/>
            <TextBox x:Name="FilterBox" Padding="3" Margin="0,0,0,6" TextChanged="FilterBox_TextChanged"/>
            <ListBox x:Name="MemberList" Height="280" SelectionMode="Single" Background="White"
                     BorderBrush="{StaticResource BorderBrush}" MouseDoubleClick="MemberList_DoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </DockPanel>
</Window>
